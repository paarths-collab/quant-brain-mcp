# Configuration reference only. No real credentials belong in this file.
# The VPS installer generates private runtime.env and client.env files outside Git.
# For manual use, copy to a private file, edit it, then export its variables:
#   set -a; source /path/to/private.env; set +a
# Python does not automatically load this file. Shell syntax, not systemd syntax.

# Outer server: use the installer to generate a token and its SHA-256 digest.
# Example shape: {"personal-research":"<64-character lowercase SHA-256 digest>"}
# Empty configuration deliberately rejects MCP access until configured.
MCP_API_KEYS='{}'
HOST=127.0.0.1
PORT=8000
# Exact comma-separated browser origins, only if a browser client needs them.
MCP_ALLOWED_ORIGINS=''
# Separate secret for /metrics/summary. Empty means metrics access is disabled.
METRICS_TOKEN=''

# Research: enable after generating secrets and signing into Codex.
QUANT_RESEARCH_ENABLED=false
QUANT_INTERNAL_TOKEN=''
QUANT_INTERNAL_MCP_URL=http://127.0.0.1:8001/mcp
QUANT_CODEX_HOME="$HOME/.quant-brain/codex"
QUANT_RESEARCH_DB="$HOME/.local/share/quant-brain/research.sqlite3"
# Empty selects the Codex runtime's default model.
QUANT_CODEX_MODEL=''
QUANT_CODEX_ROLE_TIMEOUT=120

# Optional PostgreSQL for alerts and telemetry; empty leaves these unconfigured.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=''

# Client-side only: outer bearer token for Claude Code's variable expansion.
# The VPS installer keeps this in client.env, separate from server configuration.
QUANT_CLIENT_TOKEN=''

# Do not put Codex OAuth tokens here. Use research_cli.py login --device-auth.
# VPS units pass their bind addresses and ports explicitly to uvicorn; changing
# HOST/PORT alone does not change those unit commands or the internal MCP URL.
